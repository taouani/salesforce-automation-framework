{
  "name": "salesforce-automation-framework",
  "version": "1.0.0",
  "description": "A test automation framework for Salesforce solutions that generates Playwright test suites from metadata",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sf-scanner": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "salesforce",
    "test-automation",
    "playwright",
    "metadata",
    "scanner"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fast-glob": "^3.3.2",
    "fast-xml-parser": "^5.3.1",
    "handlebars": "^4.7.8",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.6.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
