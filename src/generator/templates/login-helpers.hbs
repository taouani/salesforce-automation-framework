/**
 * Salesforce login helper utilities
 */

import { Page } from '@playwright/test';

/**
 * Salesforce login credentials from environment variables
 */
export interface SalesforceCredentials {
  username: string;
  password: string;
  securityToken?: string;
  orgUrl: string;
}

/**
 * Gets Salesforce credentials from environment variables
 */
export function getSalesforceCredentials(): SalesforceCredentials {
  const username = process.env.SF_USERNAME;
  const password = process.env.SF_PASSWORD;
  const securityToken = process.env.SF_SECURITY_TOKEN;
  const orgUrl = process.env.SF_ORG_URL || 'https://login.salesforce.com';

  if (!username || !password) {
    throw new Error('SF_USERNAME and SF_PASSWORD environment variables are required');
  }

  return {
    username,
    password,
    securityToken,
    orgUrl,
  };
}

/**
 * Logs into Salesforce org
 */
export async function loginToSalesforce(page: Page): Promise<void> {
  const credentials = getSalesforceCredentials();
  
  await page.goto(credentials.orgUrl);
  
  // Wait for login page
  await page.waitForSelector('input[name="username"]', { timeout: 10000 });
  
  // Enter username
  await page.fill('input[name="username"]', credentials.username);
  
  // Enter password
  await page.fill('input[name="password"]', credentials.password);
  
  // Click login button
  await page.click('input[name="Login"]');
  
  // Wait for navigation to Salesforce home
  await page.waitForURL(/.*salesforce\.com.*/, { timeout: 30000 });
  
  // Handle security token prompt if present
  const tokenInput = page.locator('input[name="token"]');
  if (await tokenInput.isVisible({ timeout: 5000 }).catch(() => false)) {
    if (credentials.securityToken) {
      await tokenInput.fill(credentials.securityToken);
      await page.click('input[type="submit"]');
    }
  }
}

/**
 * Navigates to Salesforce org URL
 */
export async function navigateToOrg(page: Page, orgUrl?: string): Promise<void> {
  const url = orgUrl || process.env.SF_ORG_URL || 'https://login.salesforce.com';
  await page.goto(url);
}

