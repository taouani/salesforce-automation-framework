/**
 * Test data helper utilities using faker-js
 */

import { faker } from '@faker-js/faker';

/**
 * Generates a random email address
 */
export function generateEmail(): string {
  return faker.internet.email();
}

/**
 * Generates a random name (first + last)
 */
export function generateName(): { firstName: string; lastName: string; fullName: string } {
  const firstName = faker.person.firstName();
  const lastName = faker.person.lastName();
  return {
    firstName,
    lastName,
    fullName: `${firstName} ${lastName}`,
  };
}

/**
 * Generates a random phone number
 */
export function generatePhone(): string {
  return faker.phone.number();
}

/**
 * Generates a random date in the past
 */
export function generatePastDate(yearsAgo = 1): Date {
  return faker.date.past({ years: yearsAgo });
}

/**
 * Generates a random date in the future
 */
export function generateFutureDate(yearsAhead = 1): Date {
  return faker.date.future({ years: yearsAhead });
}

/**
 * Generates a random number within range
 */
export function generateNumber(min = 0, max = 100): number {
  return faker.number.int({ min, max });
}

/**
 * Generates a random string of specified length
 */
export function generateString(length = 10): string {
  return faker.string.alphanumeric(length);
}

/**
 * Generates a random Salesforce ID (18 characters)
 */
export function generateSalesforceId(): string {
  return faker.string.alphanumeric(18).toUpperCase();
}

/**
 * Generates a random company name
 */
export function generateCompanyName(): string {
  return faker.company.name();
}

/**
 * Generates a random address
 */
export function generateAddress(): {
  street: string;
  city: string;
  state: string;
  zipCode: string;
  country: string;
} {
  return {
    street: faker.location.streetAddress(),
    city: faker.location.city(),
    state: faker.location.state(),
    zipCode: faker.location.zipCode(),
    country: faker.location.country(),
  };
}

