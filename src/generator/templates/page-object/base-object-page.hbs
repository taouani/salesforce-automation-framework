/**
 * Base Page Object class for Salesforce Object pages
 */

import { Page } from '@playwright/test';
import { waitForRecordLoad, waitForSpinnerToDisappear } from '../../utils/wait-utilities.js';

/**
 * Abstract base class for Salesforce object page objects
 */
export abstract class BaseObjectPage {
  constructor(protected page: Page) {}

  /**
   * Navigates to object list view
   */
  async goToObjectList(objectApiName: string): Promise<void> {
    const url = `/lightning/o/${objectApiName}/list`;
    await this.page.goto(url);
    await waitForRecordLoad(this.page);
  }

  /**
   * Navigates to a record detail page
   */
  async goToRecord(objectApiName: string, recordId: string): Promise<void> {
    const url = `/lightning/r/${objectApiName}/${recordId}/view`;
    await this.page.goto(url);
    await waitForRecordLoad(this.page);
  }

  /**
   * Navigates to record edit page
   */
  async goToRecordEdit(objectApiName: string, recordId: string): Promise<void> {
    const url = `/lightning/r/${objectApiName}/${recordId}/edit`;
    await this.page.goto(url);
    await waitForRecordLoad(this.page);
  }

  /**
   * Clicks Save button
   */
  async clickSave(): Promise<void> {
    const button = this.page.getByRole('button', { name: /Save/i });
    await button.waitFor({ state: 'visible' });
    await button.click();
    await waitForSpinnerToDisappear(this.page);
  }

  /**
   * Clicks Cancel button
   */
  async clickCancel(): Promise<void> {
    const button = this.page.getByRole('button', { name: /Cancel/i });
    await button.waitFor({ state: 'visible' });
    await button.click();
  }

  /**
   * Clicks Delete button
   */
  async clickDelete(): Promise<void> {
    const button = this.page.getByRole('button', { name: /Delete/i });
    await button.waitFor({ state: 'visible' });
    await button.click();
  }

  /**
   * Confirms deletion in modal
   */
  async confirmDelete(): Promise<void> {
    const confirmButton = this.page.getByRole('button', { name: /Delete/i }).last();
    await confirmButton.waitFor({ state: 'visible' });
    await confirmButton.click();
    await waitForSpinnerToDisappear(this.page);
  }

  /**
   * Fills a field by label
   */
  async fillField(fieldLabel: string, value: string): Promise<void> {
    const field = this.page.getByLabel(fieldLabel);
    await field.waitFor({ state: 'visible' });
    await field.fill(value);
  }

  /**
   * Gets field value by label
   */
  async getFieldValue(fieldLabel: string): Promise<string> {
    const field = this.page.getByLabel(fieldLabel);
    await field.waitFor({ state: 'visible' });
    return await field.inputValue();
  }

  /**
   * Resolves a Salesforce field by its API name.
   *
   * Tries the most specific selectors first (Lightning record edit forms
   * scope inputs by `field-name`), then falls back to common alternatives.
   * Use this when the field's translated label may vary across orgs/locales.
   */
  protected fieldByApiName(apiName: string) {
    const selector = [
      `lightning-input-field[field-name="${apiName}"]`,
      `lightning-input[name="${apiName}"]`,
      `lightning-textarea[name="${apiName}"]`,
      `lightning-combobox[name="${apiName}"]`,
      `[data-field-api-name="${apiName}"]`,
      `[data-field="${apiName}"]`,
      `input[name="${apiName}"]`,
      `textarea[name="${apiName}"]`,
      `select[name="${apiName}"]`,
    ].join(', ');
    return this.page.locator(selector).first();
  }

  /**
   * Fills a field by Salesforce API name (e.g. `Name`, `Custom_Field__c`).
   * Prefer this over `fillField` when locale-translated labels may differ.
   */
  async fillFieldByApiName(apiName: string, value: string): Promise<void> {
    const field = this.fieldByApiName(apiName);
    await field.waitFor({ state: 'visible' });
    // Drill into the inner editable element when the wrapper is a Lightning component.
    const editable = field.locator('input, textarea').first();
    if (await editable.count()) {
      await editable.fill(value);
    } else {
      await field.fill(value);
    }
  }

  /**
   * Returns the current value of a field by API name.
   */
  async getFieldValueByApiName(apiName: string): Promise<string> {
    const field = this.fieldByApiName(apiName);
    await field.waitFor({ state: 'visible' });
    const editable = field.locator('input, textarea').first();
    if (await editable.count()) {
      return await editable.inputValue();
    }
    return await field.inputValue();
  }

  /**
   * Returns a locator for any Salesforce inline field error. Test bodies can
   * `expect(this.fieldErrorMessage()).toBeVisible()` after a save attempt.
   */
  fieldErrorMessage() {
    return this.page
      .locator('.slds-form-element__has-error, [data-error-message], [role="alert"]')
      .first();
  }

  /**
   * Returns a locator for inline error text on a specific field by API name.
   */
  fieldErrorByApiName(apiName: string) {
    return this.fieldByApiName(apiName)
      .locator('.slds-form-element__help, [data-error-message], [aria-live="assertive"]')
      .first();
  }

  /**
   * Waits for modal to appear
   */
  async waitForModal(): Promise<void> {
    await this.page.locator('div[role="dialog"]').waitFor({ state: 'visible' });
  }

  /**
   * Closes modal
   */
  async closeModal(): Promise<void> {
    const closeButton = this.page.locator('button[title="Close"]').first();
    if (await closeButton.isVisible()) {
      await closeButton.click();
    }
  }

  /**
   * Waits for toast message
   */
  async waitForToast(message?: string): Promise<void> {
    const toast = this.page.locator('div[role="alert"]');
    await toast.waitFor({ state: 'visible' });
    if (message) {
      await this.page.getByText(message).waitFor({ state: 'visible' });
    }
  }

  /**
   * Gets toast message
   */
  async getToastMessage(): Promise<string | null> {
    const toast = this.page.locator('div[role="alert"]').first();
    if (await toast.isVisible()) {
      return await toast.textContent();
    }
    return null;
  }

  /**
   * Waits for spinner to disappear
   */
  async waitForSpinner(): Promise<void> {
    await waitForSpinnerToDisappear(this.page);
  }

  /**
   * Checks if spinner is visible
   */
  async isSpinnerVisible(): Promise<boolean> {
    const spinner = this.page.locator('.slds-spinner').first();
    return await spinner.isVisible();
  }

  /**
   * Waits for page to load completely
   */
  async waitForPageLoad(): Promise<void> {
    await waitForSpinnerToDisappear(this.page);
    await waitForRecordLoad(this.page);
  }

  /**
   * Clicks on a relationship field to navigate to the related record
   */
  async clickRelationship(fieldName: string): Promise<void> {
    // Relationship fields in Salesforce are typically clickable links
    const relationshipField = this.page.locator(`a[data-field="${fieldName}"], lightning-formatted-lookup[data-field="${fieldName}"] a, a:has-text("${fieldName}")`).first();
    await relationshipField.waitFor({ state: 'visible' });
    await relationshipField.click();
    await this.waitForPageLoad();
  }
}

